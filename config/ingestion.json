{
  "categories": [
    "cs.AI",
    "cs.LG",
    "cs.DC",
    "cs.PF",
    "cs.CV",
    "cs.CL",
    "cs.CR",
    "stat.ML"
  ],
  "taxonomyPath": "config/research-taxonomy.v1.json",
  "arxivQueryGroups": [
    {
      "id": "core-rsi",
      "terms": [
        "recursive self-improvement",
        "self-improving agent",
        "AI self-evolution",
        "continual learning",
        "meta-learning",
        "self-play"
      ],
      "maxResults": 24
    },
    {
      "id": "enabling-systems",
      "terms": [
        "efficient training",
        "distributed training",
        "LLM serving",
        "KV cache",
        "speculative decoding",
        "test-time compute"
      ],
      "maxResults": 20
    },
    {
      "id": "application-ai4s",
      "terms": [
        "AI for science",
        "automated scientific discovery",
        "scientific research agent",
        "self-driving laboratory"
      ],
      "maxResults": 16
    },
    {
      "id": "application-embodied",
      "terms": [
        "embodied AI",
        "robot learning",
        "vision-language-action",
        "world model",
        "sim-to-real"
      ],
      "maxResults": 16
    },
    {
      "id": "open-exploration",
      "terms": [
        "agent memory",
        "tool learning",
        "long-horizon reasoning",
        "automated evaluation",
        "adaptive compute"
      ],
      "maxResults": 12
    }
  ],
  "arxivHistoricalQueryGroups": [
    {
      "id": "core-rsi-history",
      "terms": [
        "recursive self-improvement",
        "self-improving agent",
        "AI self-evolution",
        "continual learning",
        "meta-learning"
      ],
      "maxResults": 32
    },
    {
      "id": "research-applications-history",
      "terms": [
        "AI for science",
        "automated scientific discovery",
        "embodied AI",
        "vision-language-action",
        "world model"
      ],
      "maxResults": 28
    }
  ],
  "arxivRequestDelaySeconds": 3,
  "maxHuggingFaceResults": 36,
  "huggingFaceQueries": [
    { "group": "core-rsi", "query": "self improving agent", "maxResults": 8 },
    {
      "group": "enabling-systems",
      "query": "language model serving",
      "maxResults": 8
    },
    { "group": "application-ai4s", "query": "AI for science", "maxResults": 6 },
    {
      "group": "application-embodied",
      "query": "embodied world model",
      "maxResults": 8
    },
    {
      "group": "open-exploration",
      "query": "agent memory tool learning",
      "maxResults": 6
    }
  ],
  "maxPublishedPapers": 96,
  "windowDays": 45,
  "historicalRetentionDays": 1095,
  "requestTimeoutSeconds": 20,
  "maxAttempts": 3,
  "backoffSeconds": 2,
  "huggingFaceRequestDelaySeconds": 1,
  "openAlexEnabled": false,
  "aiEnrichment": {
    "enabled": true,
    "provider": "bailian",
    "providers": {
      "bailian": {
        "displayName": "Alibaba Cloud Model Studio",
        "apiKeyEnv": "DASHSCOPE_API_KEY",
        "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "defaultModel": "qwen-plus",
        "legacyModelEnv": "BAILIAN_MODEL",
        "legacyBaseUrlEnv": "BAILIAN_BASE_URL"
      },
      "openai": {
        "displayName": "OpenAI",
        "apiKeyEnv": "OPENAI_API_KEY",
        "baseUrl": "https://api.openai.com/v1",
        "defaultModel": "gpt-4.1-mini"
      },
      "deepseek": {
        "displayName": "DeepSeek",
        "apiKeyEnv": "DEEPSEEK_API_KEY",
        "baseUrl": "https://api.deepseek.com",
        "defaultModel": "deepseek-chat"
      }
    },
    "systemPromptPath": "config/ai-system-prompt-v1.txt",
    "promptVersion": "zh-overview-v1",
    "maxPapersPerRun": 6,
    "timeoutSeconds": 30
  }
}
