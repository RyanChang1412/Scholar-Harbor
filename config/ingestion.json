{
  "categories": [
    "cs.AI",
    "cs.LG",
    "cs.DC",
    "cs.PF",
    "cs.CV",
    "cs.CL",
    "cs.CR",
    "stat.ML"
  ],
  "keywords": [
    "language model",
    "inference",
    "serving",
    "agent",
    "multimodal",
    "world model",
    "robotics",
    "machine learning"
  ],
  "maxArxivResults": 48,
  "maxHuggingFaceResults": 30,
  "huggingFaceQueries": [
    "language model serving",
    "AI agent",
    "multimodal model",
    "robotics world model"
  ],
  "maxPublishedPapers": 72,
  "windowDays": 30,
  "requestTimeoutSeconds": 20,
  "maxAttempts": 3,
  "backoffSeconds": 2,
  "huggingFaceRequestDelaySeconds": 1,
  "openAlexEnabled": false,
  "aiEnrichment": {
    "enabled": true,
    "provider": "bailian",
    "providers": {
      "bailian": {
        "displayName": "Alibaba Cloud Model Studio",
        "apiKeyEnv": "DASHSCOPE_API_KEY",
        "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "defaultModel": "qwen-plus",
        "legacyModelEnv": "BAILIAN_MODEL",
        "legacyBaseUrlEnv": "BAILIAN_BASE_URL"
      },
      "openai": {
        "displayName": "OpenAI",
        "apiKeyEnv": "OPENAI_API_KEY",
        "baseUrl": "https://api.openai.com/v1",
        "defaultModel": "gpt-4.1-mini"
      },
      "deepseek": {
        "displayName": "DeepSeek",
        "apiKeyEnv": "DEEPSEEK_API_KEY",
        "baseUrl": "https://api.deepseek.com",
        "defaultModel": "deepseek-chat"
      }
    },
    "systemPromptPath": "config/ai-system-prompt-v1.txt",
    "promptVersion": "zh-overview-v1",
    "maxPapersPerRun": 6,
    "timeoutSeconds": 30
  }
}
